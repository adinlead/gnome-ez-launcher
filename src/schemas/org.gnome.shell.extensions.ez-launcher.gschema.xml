<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.ez-launcher" path="/org/gnome/shell/extensions/ez-launcher/">

    <key name="animate-scroll" type="b">
      <default>true</default>
    </key>

    <key name="app-sorting" type="s">
      <default>'usage'</default>
    </key>

    <key name="columns" type="i">
      <default>9</default>
    </key>

    <key name="favorites-section" type="b">
      <default>true</default>
    </key>

    <key name="favorites-sorting" type="s">
      <default>'dash'</default>
    </key>

    <key name="category-grouping" type="b">
      <default>true</default>
    </key>

    <key name="show-favorites-in-app-grid" type="b">
      <default>false</default>
    </key>

    <key name="icon-size" type="i">
      <default>64</default>
    </key>

    <key name="icon-spacing" type="i">
      <default>24</default>
    </key>

    <!-- 读音检索策略：off 关闭；auto 按当前语言自动选择；其余值为策略 id
         （可用策略由 src/searchStrategies.js 注册，见其中接入说明） -->
    <key name="reading-search" type="s">
      <default>'auto'</default>
    </key>

    <!-- 手动更新检索缓存的跨进程信号键：prefs 每次点击按钮写入当前时间戳，
         extension 监听 changed:: 信号后对当前策略执行 updateCache + 重建索引 -->
    <key name="search-cache-refresh" type="u">
      <default>0</default>
    </key>

  </schema>
</schemalist>
